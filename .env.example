
NODE_ENV=development
PORT=5000

DATABASE_URL="replace-with-your-database-url"

JWT_ACCESS_SECRET="replace-with-a-new-random-secret"
JWT_REFRESH_SECRET="replace-with-another-random-secret"
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID="replace-with-your-google-client-id"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password"
STAFF_PASSWORD="replace-with-a-unique-password"

REDIS_USERNAME=default
REDIS_PASSWORD="replace-with-redis-password"
REDIS_HOST="replace-with-redis-host"
REDIS_PORT=6379

SMTP_USER="replace-with-smtp-user"
SMTP_SENDER="replace-with-sender-email"
SMTP_PASSWORD="replace-with-gmail-app-password"

CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"

SSLCOMMERZ_STORE_ID="replace-with-store-id"
SSLCOMMERZ_STORE_PASSWORD="replace-with-store-password"
SSLCOMMERZ_IS_LIVE=false

BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_USERNAME="replace-with-sandbox-username"
BKASH_PASSWORD="replace-with-sandbox-password"
BKASH_APP_KEY="replace-with-app-key"
BKASH_APP_SECRET="replace-with-app-secret"

DEMO_CITIZEN_EMAIL="citizen@example.com"
DEMO_CITIZEN_PASSWORD="replace-with-a-unique-password"
