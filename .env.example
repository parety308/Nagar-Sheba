# ─── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Public URL of THIS API (SSLCommerz/bKash call it back) and the frontend origin (CORS)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────
JWT_ACCESS_SECRET="generate-with: openssl rand -hex 32"
JWT_REFRESH_SECRET="generate-with: openssl rand -hex 32"
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
GOOGLE_CLIENT_ID="your-google-oauth-client-id"

# ─── Seed accounts ────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-me"
STAFF_PASSWORD="replace-me"
DEMO_CITIZEN_EMAIL="citizen@example.com"
DEMO_CITIZEN_PASSWORD="replace-me"
DEMO_ADMIN_EMAIL="demo.admin@example.com"
DEMO_ADMIN_PASSWORD=""          # leave empty to skip seeding a demo admin
SEED_DEMO_DATA=true             # false = skip the 15 sample requests

# ─── Redis ────────────────────────────────────────────────
REDIS_USERNAME=default
REDIS_PASSWORD="replace-me"
REDIS_HOST="your-redis-host"
REDIS_PORT=6379

# ─── Email (EmailJS) ──────────────────────────────────────
EMAILJS_SERVICE_ID="service_xxxxxxx"
EMAILJS_TEMPLATE_ID="template_xxxxxxx"
EMAILJS_PUBLIC_KEY="your-public-key"
EMAILJS_PRIVATE_KEY="your-private-key"
CONTACT_RECEIVER_EMAIL="inbox@example.com"

# ─── Cloudinary ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Payments ─────────────────────────────────────────────
SSLCOMMERZ_STORE_ID="your-store-id"
SSLCOMMERZ_STORE_PASSWORD="your-store-password"
SSLCOMMERZ_IS_LIVE=false

BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_USERNAME="sandbox-username"
BKASH_PASSWORD="sandbox-password"
BKASH_APP_KEY="your-app-key"
BKASH_APP_SECRET="your-app-secret"

# ─── Cron (Vercel) ────────────────────────────────────────
CRON_SECRET="generate-with: openssl rand -hex 24"
