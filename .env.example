NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nagar_sheba?schema=public"

JWT_ACCESS_SECRET=e077e5e5dffe46d3b1684624a350a88c9c5286d1240853c07e7529e18f7c80a2
JWT_REFRESH_SECRET=883b517a1ae41b1b460d5eef6d3b329f2fbc56a35317671253425a05da584b6c
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Used to build absolute links back to this API (payment callback/webhook URLs).
BACKEND_URL=http://localhost:5000

# Allowed CORS origin for the browser client.
FRONTEND_URL=http://localhost:3000

# --- Google OAuth (Social Login) ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Seed / Demo Credentials ---
# Used by src/app/lib/seed.ts to create the demo Admin account on server start.
ADMIN_EMAIL=admin@nagar-sheba.com
ADMIN_PASSWORD=ChangeMe@123
# Shared password assigned to all seeded demo Staff accounts.
STAFF_PASSWORD=ChangeMe@123

# --- Redis (OTP storage, rate-limit backing) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# --- Nodemailer (Gmail SMTP) ---
# SMTP_USER must be a Gmail address with an App Password generated at
# https://myaccount.google.com/apppasswords (not your normal Gmail password).
SMTP_USER=your_gmail_address@gmail.com
SMTP_SENDER="Nagar Sheba <your_gmail_address@gmail.com>"
SMTP_PASSWORD=your_gmail_app_password

# --- Cloudinary (file/image uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- SSLCommerz (sandbox) ---
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
SSLCOMMERZ_IS_LIVE=false

# --- bKash Tokenized Checkout (sandbox) ---
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your_sandbox_username
BKASH_PASSWORD=your_sandbox_password
BKASH_APP_KEY=your_sandbox_app_key
BKASH_APP_SECRET=your_sandbox_app_secret
