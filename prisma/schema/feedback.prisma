model Feedback {
  id        String  @id @default(uuid())
  requestId String  @unique
  citizenId String
  rating    Int
  comment   String?

  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id])
  citizen User           @relation(fields: [citizenId], references: [id])

  @@map("feedbacks")
}
