model Notification {
  id      String              @id @default(uuid())
  userId  String
  type    String
  message String
  channel NotificationChannel @default(EMAIL)
  isRead  Boolean             @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}
