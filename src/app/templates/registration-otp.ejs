<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
">


<table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background-color: #f4f7fb; padding: 40px 15px;">
    <tr>
        <td align="center">

            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="
                    max-width: 520px;
                    background-color: #ffffff;
                    border-radius: 16px;
                    overflow: hidden;
                    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
                ">

                <!-- Header -->
                <tr>
                    <td align="center"
                        style="
                            background-color: #2563eb;
                            padding: 32px 20px;
                        ">

                        <h1 style="
                            margin: 0;
                            color: #ffffff;
                            font-size: 27px;
                            font-weight: 700;
                        ">
                            Verify Your Email
                        </h1>

                        <p style="
                            margin: 10px 0 0;
                            color: #dbeafe;
                            font-size: 15px;
                        ">
                            Complete your registration securely
                        </p>

                    </td>
                </tr>

                <!-- Content -->
                <tr>
                    <td style="padding: 40px 35px;">

                        <p style="
                            margin: 0 0 15px;
                            color: #374151;
                            font-size: 16px;
                            line-height: 1.6;
                        ">
                            Hello <%= name %>,
                        </p>

                        <p style="
                            margin: 0 0 25px;
                            color: #6b7280;
                            font-size: 15px;
                            line-height: 1.7;
                        ">
                            Thank you for registering with us. To complete
                            your registration, please verify your email
                            address by entering the verification code below.
                        </p>

                        <!-- OTP -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td align="center">

                                    <div style="
                                        display: inline-block;
                                        padding: 18px 35px;
                                        background-color: #eff6ff;
                                        border: 2px dashed #2563eb;
                                        border-radius: 12px;
                                    ">

                                        <span style="
                                            color: #1d4ed8;
                                            font-size: 36px;
                                            font-weight: 700;
                                            letter-spacing: 8px;
                                        ">
                                            <%= otpValue %>
                                        </span>

                                    </div>

                                </td>
                            </tr>
                        </table>

                        <p style="
                            margin: 25px 0 0;
                            text-align: center;
                            color: #6b7280;
                            font-size: 14px;
                        ">
                            This verification code will expire in
                            <strong style="color: #374151;">
                                <%= expirationMinutes %> minutes
                            </strong>.
                        </p>

                        <p style="
                            margin: 25px 0 0;
                            color: #9ca3af;
                            font-size: 13px;
                            line-height: 1.6;
                        ">
                            If you did not create an account with us, you
                            can safely ignore this email. For your security,
                            never share this verification code with anyone.
                        </p>

                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td align="center"
                        style="
                            background-color: #f9fafb;
                            padding: 22px;
                            border-top: 1px solid #e5e7eb;
                        ">

                        <p style="
                            margin: 0;
                            color: #9ca3af;
                            font-size: 12px;
                        ">
                            © <%= new Date().getFullYear() %> Your Company.
                            All rights reserved.
                        </p>

                        <p style="
                            margin: 8px 0 0;
                            color: #9ca3af;
                            font-size: 12px;
                        ">
                            This is an automated email. Please do not reply.
                        </p>

                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>


</body>

</html>
