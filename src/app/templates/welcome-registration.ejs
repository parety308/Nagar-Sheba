<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to Your Company</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
">

<table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background-color: #f4f7fb; padding: 40px 15px;">


<tr>
    <td align="center">

        <!-- Main Card -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0"
            style="
                max-width: 520px;
                background-color: #ffffff;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
            ">

            <!-- Header -->
            <tr>
                <td align="center"
                    style="
                        background-color: #2563eb;
                        padding: 35px 20px;
                    ">

                    <!-- Success Icon -->
                    <div style="
                        width: 60px;
                        height: 60px;
                        line-height: 60px;
                        margin: 0 auto 15px;
                        background-color: #ffffff;
                        border-radius: 50%;
                        color: #2563eb;
                        font-size: 32px;
                        font-weight: bold;
                    ">
                        ✓
                    </div>

                    <h1 style="
                        margin: 0;
                        color: #ffffff;
                        font-size: 28px;
                        font-weight: 700;
                    ">
                        Welcome to Your Company!
                    </h1>

                    <p style="
                        margin: 10px 0 0;
                        color: #dbeafe;
                        font-size: 15px;
                    ">
                        Your account has been successfully created
                    </p>

                </td>
            </tr>

            <!-- Content -->
            <tr>
                <td style="padding: 40px 35px;">

                    <p style="
                        margin: 0 0 15px;
                        color: #374151;
                        font-size: 16px;
                        line-height: 1.6;
                    ">
                        Hello <%= name %>,
                    </p>

                    <p style="
                        margin: 0 0 20px;
                        color: #6b7280;
                        font-size: 15px;
                        line-height: 1.7;
                    ">
                        Congratulations! Your account has been successfully
                        created and your email address has been verified.
                    </p>

                    <p style="
                        margin: 0 0 25px;
                        color: #6b7280;
                        font-size: 15px;
                        line-height: 1.7;
                    ">
                        You can now sign in to your account and start using
                        our services.
                    </p>

                    <!-- Account Information -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0"
                        style="
                            background-color: #f8fafc;
                            border: 1px solid #e2e8f0;
                            border-radius: 10px;
                        ">

                        <tr>
                            <td style="padding: 18px;">

                                <p style="
                                    margin: 0 0 8px;
                                    color: #9ca3af;
                                    font-size: 12px;
                                ">
                                    REGISTERED EMAIL
                                </p>

                                <p style="
                                    margin: 0;
                                    color: #374151;
                                    font-size: 15px;
                                    font-weight: 600;
                                ">
                                    <%= email %>
                                </p>

                            </td>
                        </tr>

                    </table>

                    <!-- Success Message -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0"
                        style="margin-top: 25px;">

                        <tr>
                            <td style="
                                background-color: #eff6ff;
                                border: 1px solid #bfdbfe;
                                border-radius: 10px;
                                padding: 18px;
                            ">

                                <p style="
                                    margin: 0;
                                    color: #1e40af;
                                    font-size: 14px;
                                    line-height: 1.6;
                                ">
                                    ✓ Your email has been successfully
                                    verified and your account is now active.
                                </p>

                            </td>
                        </tr>

                    </table>

                    <p style="
                        margin: 25px 0 0;
                        color: #6b7280;
                        font-size: 14px;
                        line-height: 1.6;
                    ">
                        Thank you for choosing us. We are pleased to have
                        you with us.
                    </p>

                    <p style="
                        margin: 15px 0 0;
                        color: #6b7280;
                        font-size: 14px;
                        line-height: 1.6;
                    ">
                        If you have any questions or need assistance, please
                        contact our support team.
                    </p>

                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td align="center"
                    style="
                        background-color: #f9fafb;
                        padding: 22px;
                        border-top: 1px solid #e5e7eb;
                    ">

                    <p style="
                        margin: 0;
                        color: #9ca3af;
                        font-size: 12px;
                    ">
                        © <%= new Date().getFullYear() %> Your Company.
                        All rights reserved.
                    </p>

                    <p style="
                        margin: 8px 0 0;
                        color: #9ca3af;
                        font-size: 12px;
                    ">
                        This is an automated email. Please do not reply.
                    </p>

                </td>
            </tr>

        </table>

    </td>
</tr>


</table>

</body>

</html>
